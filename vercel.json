{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/superbrain",
      "destination": "https://superbrain.lowkey.tools"
    },
    {
      "source": "/superbrain/",
      "destination": "/superbrain"
    },
    {
      "source": "/superbrain/:path*",
      "destination": "https://superbrain.lowkey.tools/:path*"
    },
    {
      "source": "/supersplit",
      "destination": "https://supersplit.lowkey.tools"
    },
    { "source": "/supersplit/", "destination": "/supersplit" },
    {
      "source": "/supersplit/:path*",
      "destination": "https://supersplit.lowkey.tools/:path*"
    },
    { "source": "/favigen", "destination": "https://favigen.lowkey.tools" },
    { "source": "/favigen/", "destination": "/favigen" },
    {
      "source": "/favigen/:path*",
      "destination": "https://favigen.lowkey.tools/:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(styles.css|favicon.svg|favicon.ico|icon.svg|apple-touch-icon.png|icon-192.png|icon-512.png|og.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
